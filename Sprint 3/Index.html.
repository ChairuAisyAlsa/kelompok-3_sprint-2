    + `<div style="opacity:.75"><span>Ongkir</span><span>dihitung admin</span></div>`;
  $('cName').value = session.name;
  $('coErr').textContent = '';
  $('coDlg').showModal();
}
$('coCancel').onclick = () => $('coDlg').close();
$('coForm').addEventListener('submit', e => {
  e.preventDefault();
  const name = $('cName').value.trim(), phone = $('cPhone').value.trim(), addr = $('cAddr').value.trim(), pay = $('cPay').value;
  if(!name || !addr) return $('coErr').textContent = 'Nama dan alamat wajib diisi.';
  if(!/^(\+?62|0)8\d{7,12}$/.test(phone.replace(/[\s-]/g,''))) return $('coErr').textContent = 'Nomor WhatsApp belum benar (contoh 08123456789).';
  const items = cart.map(byId).filter(Boolean);
  const total = items.reduce((s,p) => s+p.price, 0);
  const id = 'CG' + Date.now().toString().slice(-7);
  const msg = [
    'Pesanan baru ' + id,
    '',
    ...items.map((p,i) => (i+1) + '. ' + p.name + ' (' + p.size + ') - ' + rp(p.price)),
    '',
    'Subtotal: ' + rp(total) + ' (belum termasuk ongkir)',
    'Pembayaran: ' + pay,
    '',
    'Nama: ' + name,
    'WhatsApp: ' + phone,
    'Alamat: ' + addr,
    'Akun: ' + session.email
  ].join('\n');
  const url = 'https://wa.me/' + WA_ADMIN + '?text=' + encodeURIComponent(msg);
  const orders = store.get('cg_orders',[]);
  orders.push({id, email:session.email, items:items.map(p=>p.id), total, pay, at:new Date().toISOString()});
  store.set('cg_orders', orders);
  cart = []; saveCart();
  $('coDlg').close();
  $('okId').textContent = id;
  $('okWa').href = url;
  $('okDlg').showModal();
  confetti(window.innerWidth/2, window.innerHeight/3);
  window.open(url, '_blank', 'noopener');
});
$('okClose').onclick = () => $('okDlg').close();

renderUser(); renderGrid(); renderCart(); renderMix(); rotateQuote();
</script>
