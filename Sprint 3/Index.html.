<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#f78bb1">
<title>Closet Girls Thriftshop</title>
<link href="https://googleapis.com" rel="stylesheet">
<style>
:root{
  --bg:#fdeef0;
  --ink:#5a1228;
  --accent:#d6336c;
  --btn:#f78bb1;
  --butter:#ffc9da;
  --blush:#f9b4cb;
  --lilac:#f9d3dd;
  --mint:#fbe1e6;
  --card:#fffafb;
  --line:#f1cdd6;
  --onacc:#fff;
}

*{box-sizing:border-box}
[hidden]{display:none!important}
html{scroll-behavior:smooth}
body{
  margin:0;
  background:var(--bg);
  color:var(--ink);
  font:17px/1.6 Nunito,system-ui,sans-serif;
  overflow-x:hidden;
  background-image:radial-gradient(var(--line) 1.5px,transparent 1.5px);
  background-size:26px 26px;
}
h1,h2,h3{font-family:'Bricolage Grotesque',system-ui,sans-serif;margin:0;line-height:1.05}
a{color:inherit}
:focus-visible{outline:3px solid var(--accent);outline-offset:3px}
.hand{font-family:Caveat,cursive;font-weight:700}

/* header */
header.top{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;padding:12px 5vw;position:sticky;top:0;background:var(--bg);z-index:10;border-bottom:2px solid var(--ink)}
.logo{font:800 1.4rem 'Bricolage Grotesque',sans-serif;text-decoration:none;display:flex;align-items:center;gap:8px}
.logo i{display:inline-grid;place-items:center;width:34px;height:34px;border-radius:50%;background:var(--accent);color:var(--onacc);font-style:normal;transform:rotate(-12deg);font-size:1.1rem}
.bar{display:flex;align-items:center;gap:16px;flex-wrap:wrap}
.bar a.nav{font-weight:800;text-decoration:none}
.bar a.nav:hover{text-decoration:underline wavy var(--accent)}

/* tombol */
.btn{display:inline-block;background:var(--btn);color:#5a1228;padding:12px 24px;border-radius:999px;font:800 1rem Nunito,sans-serif;text-decoration:none;border:2px solid var(--ink);cursor:pointer;box-shadow:3px 3px 0 var(--ink);transition:transform .12s,box-shadow .12s}
.btn:hover{transform:translate(-1px,-1px);box-shadow:5px 5px 0 var(--ink)}
.btn:active{transform:translate(3px,3px);box-shadow:0 0 0 var(--ink)}
.btn.ghost{background:var(--card);color:var(--ink)}
.btn.small{padding:8px 16px;font-size:.92rem;box-shadow:2px 2px 0 var(--ink)}
.btn[disabled]{opacity:.5;cursor:not-allowed;transform:none;box-shadow:2px 2px 0 var(--ink)}
.count{background:var(--ink);color:var(--bg);border-radius:999px;padding:0 8px;margin-left:6px;font-size:.85rem;display:inline-block}
.count.bump{animation:bump .4s}
@keyframes bump{40%{transform:scale(1.6) rotate(-8deg)}}

/* marquee */
.marquee{background:var(--ink);color:var(--bg);overflow:hidden;white-space:nowrap;border-bottom:2px solid var(--ink);transform:rotate(-1deg);margin:-2px -10px 0;position:relative;z-index:1}
.track{display:inline-block;padding:9px 0;animation:slide 28s linear infinite;font:800 .95rem 'Bricolage Grotesque',sans-serif;letter-spacing:.08em;text-transform:uppercase}
.track span{margin:0 18px}
.track b{color:var(--butter)}
@keyframes slide{to{transform:translateX(-50%)}}

/* hero */
.hero{padding:7vh 5vw 8vh;display:grid;gap:36px;grid-template-columns:1.15fr 1fr;align-items:center;max-width:1180px;margin:0 auto}
.kicker{display:inline-block;background:var(--mint);color:#5a1228;border:2px solid var(--ink);border-radius:999px;padding:3px 14px;font-weight:800;font-size:.9rem;transform:rotate(-2deg);margin-bottom:14px}
.hero h1{font-size:clamp(2.8rem,7vw,5.4rem);font-weight:800;letter-spacing:-.035em}
.hl{display:inline-block;padding:0 .16em;border-radius:10px;border:2px solid var(--ink);transform:rotate(-2deg);color:#5a1228}
.hl.a{background:var(--butter)}
.hl.b{background:var(--blush);transform:rotate(1.5deg)}
.hero p.lead{max-width:44ch;font-size:1.1rem;margin:22px 0 24px}
.cta{display:flex;gap:12px;flex-wrap:wrap;align-items:center}

/* kolase */
.stage{position:relative;height:460px;max-width:460px;width:100%;justify-self:center}
.fl{position:absolute;background:var(--card);border:2px solid var(--ink);border-radius:14px;box-shadow:5px 5px 0 var(--ink);padding:8px 8px 6px;text-align:center;animation:float 5s ease-in-out infinite}
.fl img{width:100%;height:175px;object-fit:cover;display:block;border-radius:8px;border:1.5px solid var(--ink);background:var(--mint)}
.fl em{display:block;font:700 1.2rem Caveat,cursive;font-style:normal;margin-top:5px;color:var(--ink);line-height:1.1}
.fl.f1{width:43%;left:0;top:15px;--r:-7deg;z-index:1}
.fl.f2{width:44%;right:8px;top:0;--r:6deg;animation-delay:-1.6s;z-index:1}
.fl.f3{width:43%;left:28%;bottom:0;--r:-2deg;animation-delay:-3.2s;z-index:2}
@keyframes float{0%,100%{transform:translateY(0) rotate(var(--r))}50%{transform:translateY(-10px) rotate(calc(var(--r) + 2deg))}}

.spin{position:absolute;right:-14px;bottom:10px;width:115px;height:115px;z-index:3;pointer-events:none}
.spin svg{width:100%;height:100%;animation:rot 14s linear infinite}
.spin .core{position:absolute;inset:0;display:grid;place-items:center;font-size:1.8rem}
@keyframes rot{to{transform:rotate(360deg)}}

.spark{position:absolute;color:var(--accent);font-size:1.4rem;animation:tw 2.4s ease-in-out infinite;z-index:3}
@keyframes tw{50%{transform:scale(.4) rotate(40deg);opacity:.4}}

/* katalog produk */
section{padding:6vh 5vw 10vh;max-width:1180px;margin:0 auto}
.sh{display:flex;align-items:baseline;gap:14px;flex-wrap:wrap;margin-bottom:24px}
.sh h2{font-size:clamp(2rem,5vw,2.8rem)}
.sh .hand{font-size:1.6rem;color:var(--accent);transform:rotate(-3deg)}

.filters{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:28px}
.filters button{font:800 .95rem Nunito,sans-serif;padding:7px 18px;border-radius:999px;border:2px solid var(--ink);background:var(--card);color:var(--ink);cursor:pointer;transition:transform .12s}
.filters button:hover{transform:rotate(-3deg) scale(1.05)}
.filters button.active{background:var(--ink);color:var(--bg)}

.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:30px 24px}
.item{background:var(--card);border:2px solid var(--ink);border-radius:18px;box-shadow:6px 6px 0 var(--ink);display:flex;flex-direction:column;position:relative;transition:transform .2s,box-shadow .2s;transform:rotate(var(--tilt,0deg));margin-top:14px;padding-bottom:16px}
.item:nth-child(3n+1){--tilt:-1.4deg}
.item:nth-child(3n+2){--tilt:1deg}
.item:nth-child(3n){--tilt:-.5deg}
.item:hover{transform:rotate(0) translateY(-6px);box-shadow:9px 11px 0 var(--ink)}
.item::before{content:"";position:absolute;top:-14px;left:50%;width:66px;height:22px;margin-left:-33px;background:rgba(255,226,122,.85);border:1px dashed rgba(74,31,51,.4);transform:rotate(-3deg);z-index:2}

.pic{height:260px;margin:14px 14px 12px;border:2px solid var(--ink);border-radius:12px;overflow:hidden;background:var(--mint)}
.pic img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .3s}
.item:hover .pic img{transform:scale(1.06)}

.info{padding:0 16px;display:flex;flex-direction:column;gap:6px;flex:1}
.tag{display:inline-block;width:fit-content;background:var(--butter);border:1.5px solid var(--ink);border-radius:999px;padding:1px 10px;font-size:.78rem;font-weight:800}
.info h3{font-size:1.25rem;margin-top:2px}
.price{font-weight:800;color:var(--accent);font-size:1.1rem;margin-bottom:8px}
.info .btn{margin-top:auto;text-align:center}

footer{text-align:center;padding:28px 5vw;border-top:2px solid var(--ink);background:var(--card);font-weight:700}

@media (max-width: 860px){
  .hero{grid-template-columns:1fr;text-align:left}
  .stage{height:410px;max-width:390px;margin-top:10px}
}
</style>
</head>
