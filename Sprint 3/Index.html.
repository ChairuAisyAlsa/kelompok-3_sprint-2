function nextDrop(){
  const n = new Date(), d = new Date(n);
  d.setHours(DROP_HOUR,0,0,0);
  d.setDate(n.getDate() + ((5 - n.getDay() + 7) % 7));
  if(d <= n) d.setDate(d.getDate() + 7);
  return d;
}
let dropAt = nextDrop();
function tick(){
  let s = Math.max(0, Math.floor((dropAt - new Date())/1000));
  if(s === 0) dropAt = nextDrop();
  const d = Math.floor(s/86400), h = Math.floor(s%86400/3600), m = Math.floor(s%3600/60), x = s%60;
  const cell = (v,l) => `<span>${String(v).padStart(2,'0')}<small>${l}</small></span>`;
  $('clock').innerHTML = cell(d,'HARI') + cell(h,'JAM') + cell(m,'MNT') + cell(x,'DTK');
}
tick(); setInterval(tick, 1000);

/* ====== toast & konfeti ====== */
let tt;
function toast(msg){
  const t = $('toast');
  t.textContent = msg; t.classList.add('show');
  clearTimeout(tt); tt = setTimeout(() => t.classList.remove('show'), 2200);
}
function confetti(x,y){
  if(reduce) return;
  const bits = ['\u2665','\u273F','\u2726','\u2736','\u2740'];
  const cols = ['#d6336c','#ff9fc2','#ffc928','#8fd4b4','#b79be0'];
  for(let i=0;i<16;i++){
    const e = document.createElement('span');
    e.className = 'cf';
    e.textContent = bits[i % bits.length];
    e.style.color = cols[i % cols.length];
    e.style.left = x+'px'; e.style.top = y+'px';
    document.body.appendChild(e);
    const a = Math.random()*Math.PI*2, v = 60 + Math.random()*90;
    e.animate([
      {transform:'translate(0,0) scale(.5) rotate(0)',opacity:1},
      {transform:`translate(${Math.cos(a)*v}px,${Math.sin(a)*v - 50}px) scale(1.3) rotate(${Math.random()*360}deg)`,opacity:1,offset:.6},
      {transform:`translate(${Math.cos(a)*v*1.2}px,${Math.sin(a)*v + 70}px) scale(.8) rotate(540deg)`,opacity:0}
    ],{duration:900 + Math.random()*400,easing:'cubic-bezier(.2,.7,.3,1)'}).onfinish = () => e.remove();
  }
}

/* ====== produk ====== */
