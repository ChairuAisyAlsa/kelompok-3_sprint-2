/* ====== mix & match ====== */
const TOPS = PRODUCTS.filter(p => p.cat==='atasan' || p.cat==='jaket');
const BOTS = PRODUCTS.filter(p => p.cat==='bawahan');
let ti = 0, bi = 0;
function slot(el,p,label,key){
