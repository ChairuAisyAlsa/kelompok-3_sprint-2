/* ====== masuk / daftar (demo di browser, bukan server) ====== */
async function hash(s){
  if(window.crypto && crypto.subtle){
    const b = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(s));
    return [...new Uint8Array(b)].map(x => x.toString(16).padStart(2,'0')).join('');
  }
  return btoa(unescape(encodeURIComponent(s)));
}
let mode = 'login';
function setMode(m){
  mode = m;
  $('tabLogin').setAttribute('aria-selected', m==='login');
  $('tabReg').setAttribute('aria-selected', m==='reg');
  $('nameWrap').hidden = m==='login';
  $('authTitle').textContent = m==='login' ? 'Masuk' : 'Daftar akun';
  $('authSubmit').textContent = m==='login' ? 'Masuk' : 'Daftar';
  $('aPass').autocomplete = m==='login' ? 'current-password' : 'new-password';
  $('authErr').textContent = '';
}
$('tabLogin').onclick = () => setMode('login');
$('tabReg').onclick = () => setMode('reg');
$('authCancel').onclick = () => { afterLogin = null; $('authDlg').close(); };
function openAuth(note){
  $('authNote').textContent = note || '';
  $('authForm').reset();
  setMode('login');
  $('authDlg').showModal();
}
$('authForm').addEventListener('submit', async e => {
  e.preventDefault();
  const email = $('aEmail').value.trim().toLowerCase();
  const pass = $('aPass').value;
  const name = $('aName').value.trim();
  const err = t => { $('authErr').textContent = t; };
  if(!/^\S+@\S+\.\S+$/.test(email)) return err('Format email belum benar.');
  if(pass.length < 6) return err('Kata sandi minimal 6 karakter.');
  const users = store.get('cg_users',{});
  const h = await hash(pass);
  if(mode==='reg'){
    if(!name) return err('Nama wajib diisi.');
    if(users[email]) return err('Email sudah terdaftar. Silakan masuk.');
    users[email] = {name, h};
    store.set('cg_users', users);
    session = {email, name};
  } else {
    const u = users[email];
    if(!u || u.h !== h) return err('Email atau kata sandi salah.');
    session = {email, name:u.name};
  }
  store.set('cg_session', session);
  $('authDlg').close();
  renderUser();
  toast('Hai, ' + session.name.split(' ')[0] + '! Selamat datang \u2665');
  if(afterLogin){ const f = afterLogin; afterLogin = null; f(); }
});
function renderUser(){
  const box = $('userbox');
  box.textContent = '';
  if(session){
    const s = document.createElement('span');
    s.textContent = 'Hai, ' + session.name.split(' ')[0] + ' ';
    const b = document.createElement('button');
    b.className = 'linkbtn'; b.type = 'button'; b.textContent = 'Keluar';
    b.onclick = () => { session = null; store.set('cg_session',null); renderUser(); };
    box.append(s,b);
  } else {
    const b = document.createElement('button');
    b.className = 'btn ghost small'; b.type = 'button'; b.textContent = 'Masuk / Daftar';
    b.onclick = () => openAuth();
    box.append(b);
  }
}

/* ====== checkout ====== */
$('checkoutBtn').onclick = () => {
  if(!cart.length) return;
  if(!session){
    afterLogin = startCheckout;
    openCart(false);
    openAuth('Masuk atau daftar dulu untuk melanjutkan checkout.');
    return;
  }
  startCheckout();
};
function startCheckout(){
  openCart(false);
  const items = cart.map(byId).filter(Boolean);
  const sub = items.reduce((s,p) => s+p.price, 0);
  $('coSum').innerHTML = items.map(p => `<div><span>${p.name}</span><span>${rp(p.price)}</span></div>`).join('')
