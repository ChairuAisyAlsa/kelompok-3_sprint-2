<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#f78bb1">
<title>Closet Girls Thriftshop</title>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@500;800&family=Caveat:wght@700&family=Nunito:wght@400;700;800&family=Pacifico&display=swap" rel="stylesheet">
<style>
:root{--bg:#fdeef0;--ink:#5a1228;--accent:#d6336c;--btn:#f78bb1;--butter:#ffc9da;--blush:#f9b4cb;--lilac:#f9d3dd;--mint:#fbe1e6;--card:#fffafb;--line:#f1cdd6;--onacc:#fff}
@media (prefers-color-scheme:dark){:root{--bg:#2a1420;--ink:#ffe6ef;--accent:#ff8fb8;--btn:#ff8fb8;--butter:#e8a0ba;--blush:#d9709a;--lilac:#e8b3c6;--mint:#f0c4d2;--card:#351b29;--line:#5a3347;--onacc:#2a1420}}
*{box-sizing:border-box}
[hidden]{display:none!important}
html{scroll-behavior:smooth}
body{margin:0;background:var(--bg);color:var(--ink);font:17px/1.6 Nunito,system-ui,sans-serif;overflow-x:hidden;
  background-image:radial-gradient(var(--line) 1.5px,transparent 1.5px);background-size:26px 26px}
h1,h2,h3{font-family:'Bricolage Grotesque',system-ui,sans-serif;margin:0;line-height:1.05}
a{color:inherit}
:focus-visible{outline:3px solid var(--accent);outline-offset:3px}
.hand{font-family:Caveat,cursive;font-weight:700}

/* header */
header.top{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;padding:12px 5vw;position:sticky;top:0;background:var(--bg);z-index:5;border-bottom:2px solid var(--ink)}
.logo{font:800 1.4rem 'Bricolage Grotesque',sans-serif;text-decoration:none;display:flex;align-items:center;gap:8px}
.logo i{display:inline-grid;place-items:center;width:34px;height:34px;border-radius:50%;background:var(--accent);color:var(--onacc);font-style:normal;transform:rotate(-12deg);font-size:1.1rem}
.bar{display:flex;align-items:center;gap:12px;flex-wrap:wrap}
.bar a.nav{font-weight:800;text-decoration:none}
.bar a.nav:hover{text-decoration:underline wavy var(--accent)}
.btn{display:inline-block;background:var(--btn);color:#5a1228;padding:12px 24px;border-radius:999px;font:800 1rem Nunito,sans-serif;text-decoration:none;border:2px solid var(--ink);cursor:pointer;box-shadow:3px 3px 0 var(--ink);transition:transform .12s,box-shadow .12s}
.btn:hover{transform:translate(-1px,-1px);box-shadow:5px 5px 0 var(--ink)}
.btn:active{transform:translate(3px,3px);box-shadow:0 0 0 var(--ink)}
.btn.ghost{background:var(--card);color:var(--ink)}
.btn.small{padding:8px 16px;font-size:.92rem;box-shadow:2px 2px 0 var(--ink)}
.btn[disabled]{opacity:.5;cursor:not-allowed;transform:none;box-shadow:2px 2px 0 var(--ink)}
.count{background:var(--ink);color:var(--bg);border-radius:999px;padding:0 8px;margin-left:6px;font-size:.85rem;display:inline-block}
.count.bump{animation:bump .4s}
@keyframes bump{40%{transform:scale(1.6) rotate(-8deg)}}

/* marquee */
.marquee{background:var(--ink);color:var(--bg);overflow:hidden;white-space:nowrap;border-bottom:2px solid var(--ink);transform:rotate(-1deg);margin:-2px -10px 0;position:relative;z-index:1}
.track{display:inline-block;padding:9px 0;animation:slide 28s linear infinite;font:800 .95rem 'Bricolage Grotesque',sans-serif;letter-spacing:.08em;text-transform:uppercase}
.track span{margin:0 18px}
.track b{color:var(--butter)}
@keyframes slide{to{transform:translateX(-50%)}}

/* hero */
.hero{padding:8vh 5vw 9vh;display:grid;gap:30px;grid-template-columns:1.15fr 1fr;align-items:center;max-width:1180px;margin:0 auto}
.kicker{display:inline-block;background:var(--mint);color:#5a1228;border:2px solid var(--ink);border-radius:999px;padding:2px 14px;font-weight:800;font-size:.9rem;transform:rotate(-2deg);margin-bottom:14px}
@media (prefers-color-scheme:dark){.kicker{color:#12261e}}
.hero h1{font-size:clamp(2.8rem,9vw,5.8rem);font-weight:800;letter-spacing:-.035em}
.hl{display:inline-block;padding:0 .15em;border-radius:10px;border:2px solid var(--ink);transform:rotate(-2deg);color:#5a1228}
.hl.a{background:var(--butter)}
.hl.b{background:var(--blush);transform:rotate(1.5deg)}
.hero p.lead{max-width:42ch;font-size:1.15rem;margin:22px 0 24px}
.cta{display:flex;gap:12px;flex-wrap:wrap;align-items:center}
.drop{margin-top:26px;display:inline-flex;gap:14px;align-items:center;background:var(--card);border:2px dashed var(--ink);border-radius:16px;padding:10px 16px}
.drop .hand{font-size:1.5rem;line-height:1}
.clock{display:flex;gap:6px}
.clock span{background:var(--ink);color:var(--bg);border-radius:8px;padding:4px 8px;font:800 1.05rem 'Bricolage Grotesque',sans-serif;min-width:48px;text-align:center;line-height:1.2}
.clock small{display:block;font:700 .62rem Nunito,sans-serif;opacity:.8;letter-spacing:.06em}
.stage{position:relative;height:430px;max-width:440px;width:100%;justify-self:center}
.fl{position:absolute;background:var(--card);border:2px solid var(--ink);border-radius:14px;box-shadow:5px 5px 0 var(--ink);padding:8px 8px 4px;text-align:center;animation:float 5s ease-in-out infinite}
.fl svg{width:100%;height:auto;stroke:#5a1228;stroke-width:1.8;stroke-linejoin:round;stroke-linecap:round;display:block;border-radius:8px}
.fl em{display:block;font:700 1.15rem Caveat,cursive;font-style:normal;margin-top:2px}
.fl.f1{width:44%;left:0;top:30px;--r:-7deg}
.fl.f2{width:46%;right:0;top:0;--r:6deg;animation-delay:-1.6s}
.fl.f3{width:44%;left:26%;bottom:0;--r:-2deg;animation-delay:-3.2s}
@keyframes float{0%,100%{transform:translateY(0) rotate(var(--r))}50%{transform:translateY(-10px) rotate(calc(var(--r) + 2deg))}}
.spin{position:absolute;right:-6px;bottom:44px;width:120px;height:120px;z-index:2}
.spin svg{width:100%;height:100%;animation:rot 14s linear infinite}
.spin .core{position:absolute;inset:0;display:grid;place-items:center;font-size:2rem}
@keyframes rot{to{transform:rotate(360deg)}}
.spark{position:absolute;color:var(--accent);animation:tw 2.4s ease-in-out infinite}
@keyframes tw{50%{transform:scale(.4) rotate(40deg);opacity:.4}}

/* sections */
section{padding:8vh 5vw;max-width:1180px;margin:0 auto}
.sh{display:flex;align-items:baseline;gap:14px;flex-wrap:wrap;margin-bottom:22px}
.sh h2{font-size:clamp(2rem,5vw,2.8rem)}
.sh .hand{font-size:1.6rem;color:var(--accent);transform:rotate(-3deg)}
.tools{display:flex;gap:12px;flex-wrap:wrap;justify-content:space-between;align-items:center;margin-bottom:28px}
.filters{display:flex;gap:10px;flex-wrap:wrap}
.filters button{font:800 .95rem Nunito,sans-serif;padding:7px 18px;border-radius:999px;border:2px solid var(--ink);background:var(--card);color:var(--ink);cursor:pointer;transition:transform .12s}
.filters button:hover{transform:rotate(-3deg) scale(1.05)}
.filters button[aria-pressed="true"]{background:var(--ink);color:var(--bg)}
.sort{display:flex;align-items:center;gap:8px;font-weight:800;font-size:.92rem}
.sort select{width:auto;padding:7px 10px;border:2px solid var(--ink);border-radius:10px}

.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(235px,1fr));gap:30px 24px}
.item{background:var(--card);border:2px solid var(--ink);border-radius:18px;box-shadow:6px 6px 0 var(--ink);display:flex;flex-direction:column;position:relative;transition:transform .2s,box-shadow .2s;transform:rotate(var(--tilt,0deg));margin-top:14px}
.item:nth-child(3n+1){--tilt:-1.4deg}
.item:nth-child(3n+2){--tilt:1deg}
.item:nth-child(3n){--tilt:-.5deg}
.item:hover{transform:rotate(0) translateY(-6px);box-shadow:9px 11px 0 var(--ink)}
.item::before{content:"";position:absolute;top:-14px;left:50%;width:66px;height:22px;margin-left:-33px;background:rgba(255,226,122,.85);border:1px dashed rgba(74,31,51,.4);transform:rotate(-3deg);z-index:2}
.pic{height:300px;margin:14px 14px 0;border:2px solid var(--ink);border-radius:12px;display:grid;place-items:center;position:relative;overflow:hidden}
.pic::after{content:"";position:absolute;inset:0;background-image:radial-gradient(circle at 50% 35%,rgba(255,255,255,.55),transparent 65%);pointer-events:none}
.pic svg{width:78%;height:92%;stroke:#5a1228;stroke-width:1.8;stroke-linejoin:round;stroke-linecap:round;position:relative;z-index:1;transition:transform .3s}
.item:hover .pic svg{transform:scale(1.06) rotate(-3deg)}
.badge{position:absolute;left:8px;top:8px;z-index:2;background:var(--butter);color:#5a1228;border:2px solid #5a1228;border-radius:999px;font:800 .72rem Nunito,sans-serif;padding:1px 10px;transform:rotate(-6deg)}
.fav{position:absolute;right:8px;top:8px;z-index:3;width:38px;height:38px;border-radius:50%;border:2px solid #5a1228;background:#fff;color:#5a1228;font-size:1.2rem;line-height:1;cursor:pointer;display:grid;place-items:center;transition:transform .15s}
.fav:hover{transform:scale(1.15)}
.fav[aria-pressed="true"]{background:var(--accent);color:#fff;animation:pop .35s}
@keyframes pop{50%{transform:scale(1.4)}}
.info{padding:12px 16px 18px;display:flex;flex-direction:column;gap:4px;flex:1}
.info h3{font-size:1.15rem}
.chips{display:flex;gap:6px;flex-wrap:wrap;margin:2px 0}
.chip{font-size:.78rem;font-weight:800;border:1.5px solid var(--ink);border-radius:999px;padding:0 9px}
.chip.c1{background:var(--lilac);color:#5a1228}
.chip.c2{background:var(--mint);color:#5a1228}
.price{font:800 1.5rem 'Bricolage Grotesque',sans-serif;color:var(--accent);margin:2px 0 10px}
.price s{font:700 .85rem Nunito;opacity:.5;margin-left:6px;color:var(--ink)}
.info .btn{margin-top:auto;text-align:center}
.nores{grid-column:1/-1;text-align:center;padding:30px;font-weight:700;opacity:.8}

/* mix & match */
.mix{background:var(--lilac);color:#5a1228;border:2px solid var(--ink);border-radius:28px;box-shadow:7px 7px 0 var(--ink);padding:clamp(20px,4vw,40px);max-width:1180px}
.mixwrap{padding:4vh 5vw}
.mix h2{font-size:clamp(2rem,5vw,2.8rem)}
.mix .hand{font-size:1.6rem}
.mixgrid{display:grid;grid-template-columns:1fr 1fr 1fr;gap:18px;margin-top:22px;align-items:stretch}
.slot{background:var(--card);color:var(--ink);border:2px solid var(--ink);border-radius:16px;padding:12px;text-align:center;display:flex;flex-direction:column;gap:6px}
.slot .view{height:170px;border-radius:10px;display:grid;place-items:center;border:2px solid var(--ink);transition:background .25s}
.slot svg{width:70%;height:94%;stroke:#5a1228;stroke-width:1.8;stroke-linejoin:round;stroke-linecap:round}
.slot b{font:800 1rem 'Bricolage Grotesque',sans-serif;line-height:1.15}
.slot small{opacity:.8}
.arrows{display:flex;justify-content:center;gap:10px}
.arrows button{width:40px;height:40px;border-radius:50%;border:2px solid var(--ink);background:var(--butter);color:#5a1228;font-size:1.1rem;font-weight:800;cursor:pointer}
.arrows button:hover{transform:scale(1.12)}
.mixsum{background:var(--ink);color:var(--bg);border-radius:16px;padding:18px;display:flex;flex-direction:column;justify-content:center;gap:10px;text-align:center}
.mixsum .big{font:800 2.2rem 'Bricolage Grotesque',sans-serif;color:var(--butter)}
.mixsum .btn{box-shadow:3px 3px 0 var(--bg)}
.mixsum .btn.ghost{background:transparent;color:var(--bg);border-color:var(--bg)}

/* steps */
.steps{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:24px}
.step{background:var(--card);border:2px solid var(--ink);border-radius:18px;padding:22px 20px;position:relative;box-shadow:5px 5px 0 var(--ink)}
.step:nth-child(1){transform:rotate(-1.2deg);background:var(--butter);color:#5a1228}
.step:nth-child(2){transform:rotate(.8deg)}
.step:nth-child(3){transform:rotate(-.6deg);background:var(--mint);color:#5a1228}
.step .n{position:absolute;top:-18px;left:16px;width:40px;height:40px;border-radius:50%;background:var(--accent);color:var(--onacc);border:2px solid var(--ink);display:grid;place-items:center;font:800 1.2rem 'Bricolage Grotesque'}
.step h3{font-size:1.3rem;margin:10px 0 4px}
.step p{margin:0}

/* why */
.why{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:16px}
.why div{border:2px dashed var(--ink);border-radius:16px;padding:16px;text-align:center}
.why .ic{font-size:2rem;display:block}
.why b{font:800 1.1rem 'Bricolage Grotesque'}

details{border:2px solid var(--ink);border-radius:14px;background:var(--card);padding:12px 18px;margin-bottom:12px}
details[open]{box-shadow:4px 4px 0 var(--accent)}
summary{cursor:pointer;font-weight:800}
details p{margin:8px 0 0}
footer{padding:44px 5vw;border-top:2px solid var(--ink);text-align:center;background:var(--butter);color:#5a1228}
footer .hand{font-size:2rem;display:block}

/* toast & confetti */
#toast{position:fixed;left:50%;bottom:22px;transform:translate(-50%,120px);background:var(--ink);color:var(--bg);padding:10px 20px;border-radius:999px;font-weight:800;z-index:30;transition:transform .3s;max-width:90vw;text-align:center}
#toast.show{transform:translate(-50%,0)}
.cf{position:fixed;z-index:40;pointer-events:none;font-size:18px;line-height:1}

/* keranjang */
.scrim{position:fixed;inset:0;background:rgba(0,0,0,.4);opacity:0;pointer-events:none;transition:opacity .2s;z-index:10}
.scrim.open{opacity:1;pointer-events:auto}
.drawer{position:fixed;top:0;right:0;height:100%;width:min(410px,100%);background:var(--card);border-left:2px solid var(--ink);z-index:11;transform:translateX(100%);transition:transform .25s;display:flex;flex-direction:column}
.drawer.open{transform:none}
.drawer header{display:flex;justify-content:space-between;align-items:center;padding:18px 20px;border-bottom:2px solid var(--ink)}
.drawer h2{font-size:1.5rem;margin:0}
.lines{flex:1;overflow:auto;padding:0 20px}
.line{display:flex;gap:12px;align-items:center;padding:12px 0;border-bottom:1px dashed var(--ink)}
.line .mini{width:56px;height:56px;border-radius:10px;border:2px solid var(--ink);display:grid;place-items:center;flex:none}
.line .mini svg{width:90%;height:90%;stroke:#5a1228;stroke-width:3.2;stroke-linejoin:round;stroke-linecap:round}
.line div.t{flex:1;min-width:0}
.line b{display:block;line-height:1.2}
.line small{opacity:.75}
.linkbtn{background:none;border:0;color:var(--accent);font:800 .9rem Nunito,sans-serif;cursor:pointer;text-decoration:underline}
.sum{padding:16px 20px;border-top:2px solid var(--ink)}
.sum .total{display:flex;justify-content:space-between;font-weight:800;font-size:1.25rem;margin-bottom:8px}
.empty{padding:30px 0;text-align:center;opacity:.8}
.empty .hand{font-size:1.6rem;display:block}

/* keranjang cantik */
.drawer{background-image:radial-gradient(var(--line) 1.2px,transparent 1.2px);background-size:20px 20px}
.drawer header{background:#f78bb1;color:#5a1228}
.drawer header .ttl{display:flex;align-items:center;gap:10px}
.drawer header svg{width:46px;height:23px;fill:none;stroke:#5a1228;stroke-width:2.4;stroke-linecap:round;stroke-linejoin:round;transform-origin:50% 0;animation:swing 3s ease-in-out infinite}
.drawer header small{display:block;font:700 1.15rem/1 Caveat,cursive}
.drawer header .linkbtn{color:#5a1228}
@keyframes swing{50%{transform:rotate(7deg)}}
.lines{padding:18px;display:grid;gap:14px;align-content:start}
.line{position:relative;background:var(--card);border:2px solid var(--ink);border-radius:14px;box-shadow:3px 3px 0 var(--ink);padding:10px;gap:12px;animation:drop .35s}
.line:nth-child(odd){transform:rotate(-.7deg)}
.line:nth-child(even){transform:rotate(.6deg)}
.line .mini{width:62px;height:62px}
.line .price2{display:block;font:800 1.05rem 'Bricolage Grotesque',sans-serif;color:var(--accent)}
.line .rm{width:32px;height:32px;border-radius:50%;border:2px solid var(--ink);background:var(--card);color:var(--ink);font:800 1.1rem/1 Nunito,sans-serif;cursor:pointer;flex:none}
.line .rm:hover{background:var(--accent);color:var(--onacc)}
@keyframes drop{from{opacity:0;transform:translateY(-12px)}}
.empty{display:grid;justify-items:center;gap:6px;padding:26px 0}
.empty svg{width:120px;height:60px;fill:none;stroke:var(--ink);stroke-width:2;stroke-linecap:round;stroke-linejoin:round;transform-origin:50% 0;animation:swing 3s ease-in-out infinite}
.empty p{margin:0 0 6px}
.sum{padding:0 18px 18px;border-top:0;background:transparent}
.receipt{background:#fffdf3;color:#5a1228;border:2px dashed #5a1228;border-radius:8px;padding:14px 16px 12px;margin-top:12px;font:700 .92rem/1.7 'Courier New',monospace}
.receipt .rhead{text-align:center;font-weight:800;letter-spacing:.12em;border-bottom:2px dashed #5a1228;padding-bottom:6px;margin-bottom:6px}
.rrow{display:flex;justify-content:space-between;gap:8px}
.rrow.tot{border-top:2px dashed #5a1228;margin-top:6px;padding-top:6px;font-size:1.1rem;font-weight:800}
.rsmall{font-size:.78rem;opacity:.75}
.barcode{height:24px;margin:10px 0 2px;background:repeating-linear-gradient(90deg,#5a1228 0 2px,transparent 2px 4px,#5a1228 4px 5px,transparent 5px 8px,#5a1228 8px 11px,transparent 11px 13px)}
.rthx{text-align:center;font-size:.75rem;letter-spacing:.08em}
.cartquote{text-align:center;font-size:1.35rem;line-height:1.15;color:var(--accent);margin:12px 6px 6px}
.sum .note{text-align:center;margin-bottom:12px}

/* kata-kata thrift & kamus */
.notes{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:24px}
.note2{position:relative;margin:0;border:2px solid var(--ink);border-radius:6px 6px 22px 6px;padding:34px 20px 20px;box-shadow:5px 5px 0 var(--ink);color:#5a1228;font:700 1.5rem/1.2 Caveat,cursive;transform:rotate(var(--r,0deg));transition:transform .2s}
.note2:hover{transform:rotate(0) translateY(-4px)}
.note2::before{content:"\201C";position:absolute;top:2px;left:14px;font:800 3.4rem/1 'Bricolage Grotesque',sans-serif;color:var(--accent)}
.note2::after{content:"";position:absolute;top:-11px;right:22px;width:48px;height:18px;background:rgba(255,255,255,.65);border:1px dashed rgba(74,31,51,.35);transform:rotate(5deg)}
.dict{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:16px}
.dict div{background:var(--card);border:2px solid var(--ink);border-radius:16px;padding:16px 18px;transition:transform .2s,box-shadow .2s}
.dict div:hover{transform:rotate(-1deg) translateY(-3px);box-shadow:4px 4px 0 var(--accent)}
.dict b{display:block;font:800 1.3rem 'Bricolage Grotesque',sans-serif;color:var(--accent)}
.dict p{margin:2px 0 0}

/* dialog */
dialog{background:var(--card);color:var(--ink);border:2px solid var(--ink);border-radius:20px;padding:26px;width:min(440px,92vw);box-shadow:8px 8px 0 var(--ink)}
dialog::backdrop{background:rgba(0,0,0,.5)}
dialog h2{font-size:1.6rem;margin-bottom:6px}
.tabs{display:flex;gap:8px;margin:14px 0}
.tabs button{flex:1;padding:8px;border-radius:999px;border:2px solid var(--ink);background:transparent;color:var(--ink);font:800 .95rem Nunito,sans-serif;cursor:pointer}
.tabs button[aria-selected="true"]{background:var(--ink);color:var(--bg)}
form{display:grid;gap:12px}
label{display:grid;gap:4px;font-weight:800;font-size:.95rem}
input,textarea,select{font:inherit;padding:11px;border:2px solid var(--ink);border-radius:10px;background:var(--bg);color:var(--ink);width:100%}
.err{color:#c0182f;font-weight:800;min-height:1.2em;margin:0;font-size:.92rem}
@media (prefers-color-scheme:dark){.err{color:#ff8a9b}}
.note{font-size:.88rem;opacity:.75;margin:0}
.row{display:flex;gap:10px;justify-content:flex-end;flex-wrap:wrap}
.ordersum{background:var(--bg);border:2px dashed var(--ink);border-radius:12px;padding:12px 14px;font-size:.95rem}
.ordersum div{display:flex;justify-content:space-between;gap:10px}

@media (max-width:860px){.hero{grid-template-columns:1fr}.stage{height:380px}.mixgrid{grid-template-columns:1fr 1fr}.mixsum{grid-column:1/-1}}
@media (max-width:480px){.mixgrid{grid-template-columns:1fr}}
@media (prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}.track{animation:none}}

/* login ala desain: awan pink + logo hanger */
#authDlg{position:relative;overflow:hidden;padding:78px 26px 72px;border-radius:26px}
#authDlg .cl{position:absolute;left:0;width:100%;height:80px;pointer-events:none}
#authDlg .cl.t{top:0}#authDlg .cl.b{bottom:0}
#authDlg>*:not(.cl){position:relative;z-index:1}
.alogo{display:grid;justify-items:center;margin-bottom:4px;color:var(--ink)}
.alogo svg{width:64px}
.alogo span{font-family:Pacifico,cursive;font-size:1.7rem;color:var(--accent);line-height:1.1}
