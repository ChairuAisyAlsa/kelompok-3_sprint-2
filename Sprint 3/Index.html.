<script>
/* ====== PENGATURAN: ganti nomor WhatsApp admin (format 62, tanpa 0 di depan) ====== */
const WA_ADMIN = '6281234567890';
/* Jam stok baru tiap Jumat (0-23, waktu perangkat pembeli) */
const DROP_HOUR = 18;

/* ====== gantungan baju untuk keranjang kosong ====== */
const HANGER = '<path d="M50 20 V15 C50 10 55 8 57 11 C59 14 55 16 53 15" fill="none"/><path d="M50 20 L20 36 Q18 38 21 38 H79 Q82 38 80 36 Z" fill="none"/>';

/* FOTO PRODUK: upload foto kolase ke repo dengan nama kolase.jpg (satu file saja) */
const KOLASE = 'kolase.jpg';
const CROP = { /* [x, y, lebar, tinggi] bagian foto kolase */
  cardigan:[0,37,400,526], rok:[402,32,396,533], hoodie:[802,34,396,531],
  kemeja:[0,632,400,533], jeans:[432,600,336,565], dress:[808,612,382,578]
};
const crop = (k,label) => `<svg class="ph" viewBox="${CROP[k].join(' ')}" preserveAspectRatio="xMidYMid slice" role="img" aria-label="${label||''}"><image href="${KOLASE}" width="1200" height="1200"/></svg>`;
/* foto polaroid di bagian Tentang + tombol WhatsApp di Cara pesan */
(function(){
