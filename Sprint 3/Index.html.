.stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(120px,1fr));gap:12px;margin-top:20px}
.stats div{background:var(--butter);color:#5a1228;border:2px solid var(--ink);border-radius:14px;padding:10px 12px;box-shadow:3px 3px 0 var(--ink)}
.stats div:nth-child(2){background:var(--mint)}.stats div:nth-child(3){background:var(--lilac)}.stats div:nth-child(4){background:var(--blush)}
.stats b{display:block;font:800 1.4rem 'Bricolage Grotesque',sans-serif;line-height:1.1}
.stats span{font-size:.85rem;line-height:1.2;display:block}
.polas{position:relative;aspect-ratio:1/1;width:100%;max-width:520px;margin:0 auto}
.pola{position:absolute;width:48%;margin:0;background:#fff;padding:8px 8px 32px;border:2px solid var(--ink);border-radius:6px;box-shadow:5px 5px 0 var(--ink);transition:transform .25s}
.pola em{position:absolute;left:0;right:0;bottom:5px;text-align:center;font:700 1.15rem Caveat,cursive;font-style:normal;color:#5a1228}
.pola.a{left:0;top:2%;transform:rotate(-6deg)}
.pola.b{right:0;top:0;transform:rotate(5deg)}
.pola.c{left:25%;bottom:0;transform:rotate(-1.5deg);z-index:2}
.pola:hover{transform:rotate(0) scale(1.04);z-index:3}
.pola.a em{text-align:left;padding-left:10px}
.pola.b em{text-align:right;padding-right:10px}
.ph{display:block}
.pic svg.ph,.slot svg.ph,.line .mini svg.ph{width:100%;height:100%}
.fl svg.ph{width:100%;height:auto;aspect-ratio:3/4}
.item:hover .pic svg.ph{transform:scale(1.06)}
.pola svg.ph{width:100%;aspect-ratio:3/4}
.lead2{margin:-8px 0 30px;max-width:60ch;font-size:1.1rem}
.step:nth-child(4){transform:rotate(.7deg);background:var(--lilac);color:#5a1228}
.step:nth-child(5){transform:rotate(-1deg);background:var(--blush);color:#5a1228}
@media (min-width:1000px){.steps.five{grid-template-columns:repeat(5,1fr);gap:20px}.steps.five .step h3{font-size:1.15rem}.steps.five .step p{font-size:.95rem}}
.tipbox{margin-top:34px;border:2px dashed var(--ink);border-radius:18px;padding:20px 22px;background:var(--card)}
.tipbox p{margin:0 0 12px}
.tipbox .hand{font-size:1.5rem;color:var(--accent)}
.chips{display:flex;flex-wrap:wrap;gap:10px;margin-bottom:16px}
.chips span{border:2px solid var(--ink);border-radius:999px;padding:4px 14px;font-weight:800;font-size:.92rem;background:var(--butter);color:#5a1228}
